            <artifactId>dsp</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>configuration-filesystem</artifactId>
            <version>${edc}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>management-api</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>edr-store-core</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
