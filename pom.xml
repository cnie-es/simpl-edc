        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>edr-cache-api</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>data-plane-selector-api</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>data-plane-selector-core</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>data-plane-self-registration</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>data-plane-signaling-api</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>data-plane-control-api</artifactId>
            <version>0.8.1</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>data-plane-public-api-v2</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>data-plane-core</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>data-plane-iam</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>token-core</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>data-plane-http</artifactId>
