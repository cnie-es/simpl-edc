<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Fork coordinates: this derivative work is published under a namespace controlled by
         CNIE-ES. The upstream namespace eu.europa.ec.simpl is kept only where it correctly
         identifies a third-party component, never to identify this modified artifact.
         EUPL-1.2 Art. 5, Legal Protection. -->
    <groupId>es.cnie.simpl</groupId>
    <artifactId>simpl-edc</artifactId>
    <!-- Pinned. Upstream carried ${env.PROJECT_RELEASE_VERSION}, a variable of the GitLab pipeline
         that is not part of this fork: nothing in the GitHub workflow or the Dockerfile sets it, so
         the placeholder reached the build unresolved. -->
    <version>1.0.21-edval</version>
    <name>simpl-edc (CNIE-ES fork)</name>
    <description>SIMPL EDC connector - modified version of SIMPL simpl-edc (upstream commit c9368a6), modified by the EDNEL-RIOJA project team for CNIE-ES between 2025-12-11 and 2026-09-11. See NOTICE.EDNEL.md.</description>
    <url>https://github.com/cnie-es/simpl-edc</url>

    <licenses>
        <license>
            <name>European Union Public Licence v. 1.2 (EUPL-1.2)</name>
            <url>https://eupl.eu/1.2/en/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>EDNEL-RIOJA project team</name>
            <organization>CNIE-ES</organization>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/cnie-es/simpl-edc.git</connection>
        <developerConnection>scm:git:git@github.com:cnie-es/simpl-edc.git</developerConnection>
        <url>https://github.com/cnie-es/simpl-edc</url>
    </scm>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <edc>0.10.1</edc>
        <!-- AWS S3 extensions must stay aligned with the EDC core version (provisioning
             framework / aws-s3-core SPI compatibility). Do not mix with 0.15.x. -->
        <awsS3>0.10.1</awsS3>
        <ionosEdcSimplInfraVersion>1.0.1</ionosEdcSimplInfraVersion>
        <eclipseGroupId>org.eclipse.edc</eclipseGroupId>
        <edcForkedRepositoryProjectId>958</edcForkedRepositoryProjectId>
        <s3PluginForkProjectId>1259</s3PluginForkProjectId>
        <minio.s3.version>0.0.1</minio.s3.version>
    </properties>

    <dependencies>
        <!-- Minio S3 Extension JARs - Now from GitLab Maven Repository -->
        <dependency>
            <groupId>fr.gxfs.edc</groupId>
            <artifactId>minio-s3-core</artifactId>
            <version>${minio.s3.version}</version>
        </dependency>
        <dependency>
            <groupId>fr.gxfs.edc</groupId>
            <artifactId>minio-s3-data-plane</artifactId>
            <version>${minio.s3.version}</version>
        </dependency>
        <dependency>
            <groupId>fr.gxfs.edc</groupId>
            <artifactId>minio-s3-control-plane</artifactId>
            <version>${minio.s3.version}</version>
        </dependency>
        <!-- Minio client still needed as transitive dependency -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.6.0</version>
        </dependency>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>9.47</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.36</version>
        </dependency>

        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>connector-core</artifactId>
            <version>forked-1.1.10</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.edc</groupId>
            <artifactId>keys-lib</artifactId>
            <version>${edc}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>control-api-configuration</artifactId>
            <version>${edc}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>control-plane-api</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>control-plane-api-client</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>control-plane-core</artifactId>
            <version>${edc}</version>
        </dependency>
        <dependency>
            <groupId>${eclipseGroupId}</groupId>
            <artifactId>transaction-local</artifactId>
